# ─────────────────────────────────────────────────────────────────────────────
# AURELIA storefront — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL="mysql://aurelia_user:your-password@127.0.0.1:3306/aurelia_dev"

# ── App URL (required) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://aurelia.in"

# ── NextAuth v5 (required) ───────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-strong-random-secret"
NEXTAUTH_URL="https://aurelia.in"

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" to show the "Continue with Google" button on login/register
NEXT_PUBLIC_GOOGLE_AUTH="false"

# ── Email — Gmail SMTP (recommended, free) ───────────────────────────────────
# Use your Gmail account to send order confirmations, OTPs, and notifications.
#
# SETUP (2 minutes):
#   1. Go to your Google Account → Security
#   2. Enable 2-Step Verification (required for App Passwords)
#   3. Go to: https://myaccount.google.com/apppasswords
#   4. Select "Mail" → "Other" → name it "AURELIA" → Generate
#   5. Copy the 16-character App Password (no spaces needed)
#
EMAIL_GMAIL_USER="yourstore@gmail.com"
EMAIL_GMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="AURELIA <yourstore@gmail.com>"

# ── Email — Resend (alternative, optional) ────────────────────────────────────
# If you prefer Resend over Gmail SMTP, set these instead.
RESEND_API_KEY=""

# ── AI product images ─────────────────────────────────────────────────────────
# Used by `npm run images:generate` to generate photorealistic product photos.
#
# PRIMARY (recommended, free):  Pollinations.ai  →  gpt-image-2 model
#   Get a FREE key: https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=""
#
# FALLBACK (if above not set):  Hugging Face  →  FLUX.1-schnell
#   Get a FREE token: https://huggingface.co/settings/tokens
HF_API_KEY=""
#
# OPTIONAL: Gemini writes richer per-product prompts (free text API)
#   Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ── Payments — Razorpay (optional, required for live checkout) ───────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Maintenance cron (optional) ──────────────────────────────────────────────
# Secret required by /api/maintenance/cleanup-tokens
CLEANUP_SECRET="replace-with-random-string"

# ── Error monitoring — Sentry (optional) ─────────────────────────────────────
# Leave DSNs blank to fully disable Sentry (default for local dev).
# Get from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Sampling (0.0–1.0). Lower = fewer events / less quota used.
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_RATE="0"
# Build-time source-map upload (optional; needed for readable stack traces).
# Create a token at https://sentry.io → Settings → Auth Tokens (project:releases scope).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── Payments — Encryption key (required when using Merchant UPI) ─────────────
# AES-256-GCM key for encrypting merchant API credentials in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_ENCRYPTION_KEY=""

# ── Payments — Razorpay webhook secret ───────────────────────────────────────
# Webhook secret configured in Razorpay dashboard (Settings → Webhooks).
# Webhook URL: https://yourdomain.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ── SMS — SMS Horizon (smshorizon.in) ────────────────────────────────────────
# Recommended Indian SMS provider. Sub-3s OTP delivery, DLT compliant.
# Sign up: https://www.smshorizon.in — 500 free credits, no card required.
#
# SETUP:
#   1. Sign up and copy your API key from Dashboard → API Keys
#   2. Register a 6-character Sender ID on the TRAI DLT portal
#      (SMS Horizon helps with this registration for free)
#   3. Register your OTP message template and note the DLT Template ID
#   4. Configure in Admin → Settings → Email & SMS (DB config overrides these)
#
SMS_PROVIDER="smshorizon"
SMS_API_KEY=""
SMS_SENDER_ID="HORIZN"
SMS_DLT_TEMPLATE_ID=""
