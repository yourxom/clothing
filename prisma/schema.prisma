// Phase 2 catalogue foundation. Other commerce entities are added with their feature phases.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductImageType {
  PRODUCT
  MODEL
  DETAIL
  LIFESTYLE
  VIDEO
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  sku         String           @unique
  slug        String           @unique
  name        String
  description String           @db.Text
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  color       String
  fabric      String
  tone        String
  price       Int              // INR minor units (paise), not floating point
  mrp         Int              // INR minor units (paise)
  published   Boolean          @default(false)
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, published])
  @@index([published, createdAt])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String           @db.Text
  type      ProductImageType @default(PRODUCT)
  altText   String
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String     @unique
  size      String
  color     String
  inventory Inventory?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([productId, size, color])
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  updatedAt DateTime       @updatedAt
}
